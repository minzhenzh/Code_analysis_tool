{
  "name": "exception-antipattern-detector",
  "version": "1.0.0",
  "description": "Detects exception handling anti-patterns (Unreachable Handler, Log and Throw, Throws Kitchen Sink) in Java source code",
  "bin": {
    "antipattern-detector": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/tests",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "analyze": "node dist/cli.js",
    "ast": "node dist/printAst.js",
    "test": "tsc && node --test --test-reporter=spec \"dist/tests/*.test.js\""
  },
  "author": "Minzhen Zhang",
  "license": "MIT",
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
